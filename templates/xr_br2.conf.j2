! ============================================================
! BR2 (PoP-B) —— Cisco IOS-XRv9k 配置片段（对应 2.1 §3-§六）
! 接 Transit-2(AS64501) + IX + PNI备(Eyeball-C)
! 由 03-config.yml 经 cisco.iosxr.iosxr_config 合并下发
! ============================================================
!
interface Loopback0
 ipv4 address {{ lo.br2 }} 255.255.255.255
!
! ---- 物理接口编址（基础业务）----
! Gi0/0/0/0=Transit-2  Gi0/0/0/1=核心↔RR1  Gi0/0/0/2=核心↔RR2  Gi0/0/0/3=PNI(Eyeball-C)  Gi0/0/0/4=IX
interface GigabitEthernet0/0/0/0
 ipv4 address {{ br2_transit_ip }} 255.255.255.252
!
interface GigabitEthernet0/0/0/1
 ipv4 address {{ core_links.br2_rr1.br }} 255.255.255.252
!
interface GigabitEthernet0/0/0/2
 ipv4 address {{ core_links.br2_rr2.br }} 255.255.255.252
!
interface GigabitEthernet0/0/0/3
 ipv4 address {{ br2_pni_ip }} 255.255.255.252
!
interface GigabitEthernet0/0/0/4
 ipv4 address {{ ix_br2_ip }} 255.255.255.0
!
router isis CORE
 is-type level-2-only
 net {{ isis_area }}.0100.6425.5002.00
 address-family ipv4 unicast
  metric-style wide
 interface Loopback0
  passive
  address-family ipv4 unicast
 interface GigabitEthernet0/0/0/1
  point-to-point
  address-family ipv4 unicast
 interface GigabitEthernet0/0/0/2
  point-to-point
  address-family ipv4 unicast
!
prefix-set MY-PREFIXES
  {{ my_prefix }} le 24
end-set
!
prefix-set BOGONS
  0.0.0.0/8 le 32, 10.0.0.0/8 le 32, 127.0.0.0/8 le 32,
  169.254.0.0/16 le 32, 172.16.0.0/12 le 32, 192.168.0.0/16 le 32,
  224.0.0.0/3 le 32
end-set
!
! ---- RPKI ---- (enable_rpki=false 时整段跳过，基础业务不依赖 Routinator)
router bgp {{ my_asn }}
{% if enable_rpki %}
 rpki server {{ rpki_rtr_host }}
  transport tcp port {{ rpki_rtr_port }}
  refresh-time 120
 !
{% endif %}
 bgp router-id {{ lo.br2 }}
 address-family ipv4 unicast
{% if enable_rpki %}
  bgp origin-as validation enable
{% endif %}
  network {{ my_prefix }}
 !
 ! ---- iBGP 到两台 RR ----
 neighbor {{ lo.rr1 }}
  remote-as {{ my_asn }}
  update-source Loopback0
  address-family ipv4 unicast
   next-hop-self
 !
 neighbor {{ lo.rr2 }}
  remote-as {{ my_asn }}
  update-source Loopback0
  address-family ipv4 unicast
   next-hop-self
 !
 ! ---- eBGP: Transit-2 (AS64501) ----
 neighbor {{ transit_as64501_peer }}
  remote-as {{ transit2_asn }}
  address-family ipv4 unicast
   route-policy TRANSIT-IN in
   route-policy TRANSIT-OUT out
   next-hop-self
   maximum-prefix 1000000 90 restart 30
 !
 ! ---- eBGP: PNI 备 Eyeball-C (AS64511) ----
 neighbor {{ pni_eyeballC_peer }}
  remote-as {{ eyeballC_asn }}
  address-family ipv4 unicast
   route-policy PNI-IN in
   route-policy PEER-OUT out
   next-hop-self
 !
 ! ---- eBGP: IX Route-Server (AS65000) ----
 neighbor {{ ix_rs_ip }}
  remote-as {{ rs_asn }}
  address-family ipv4 unicast
   route-policy PEER-IN in
   route-policy PEER-OUT out
!
interface GigabitEthernet0/0/0/0
 ipv4 verify unicast source reachable-via any
interface GigabitEthernet0/0/0/4
 ipv4 verify unicast source reachable-via any
!
