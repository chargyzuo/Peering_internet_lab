! ============================================================
! RR (Route Reflector) —— FRR frr.conf（对应 2.1 §3.3）
! RR 只反射 iBGP + 跑 IS-IS 解析 next-hop，不在转发路径
! 渲染变量取自 group_vars/all.yml
! ============================================================
frr version 8.4
frr defaults traditional
hostname {{ inventory_hostname }}
log syslog informational
!
! ---- IS-IS：只搬 loopback + 互联，让 RR 能解析 iBGP next-hop ----
router isis CORE
 is-type level-2-only
 net {{ isis_area }}.0100.6425.50{{ '11' if inventory_hostname == 'rr1' else '12' }}.00
 metric-style wide
!
interface lo
 ip address {{ lo[inventory_hostname] }}/32
 ip router isis CORE
 isis passive
!
interface eth1
 ip router isis CORE
 isis network point-to-point
!
interface eth2
 ip router isis CORE
 isis network point-to-point
!
! ---- iBGP 路由反射：两台 BR 都是 client ----
router bgp {{ my_asn }}
 bgp router-id {{ lo[inventory_hostname] }}
 neighbor {{ lo.br1 }} remote-as {{ my_asn }}
 neighbor {{ lo.br1 }} update-source lo
 neighbor {{ lo.br2 }} remote-as {{ my_asn }}
 neighbor {{ lo.br2 }} update-source lo
 !
 address-family ipv4 unicast
  neighbor {{ lo.br1 }} route-reflector-client
  neighbor {{ lo.br2 }} route-reflector-client
  ! 不配 next-hop-self：RR 默认保留 BR 的原始 next-hop（RR 不在转发路径）
 exit-address-family
!
line vty
!
